<?xml version="1.0" encoding="utf-8"?>
<!--
    Events are subscribed only to keep the system's node cache fresh; the service ignores them.
    flagRetrieveInteractiveWindows: find the app window even when the keyboard window is "active".
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewFocused|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/smart_enter_accessibility_description"
    android:notificationTimeout="100"
    android:summary="@string/smart_enter_accessibility_summary_short" />
